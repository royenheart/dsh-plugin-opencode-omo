+  it('appends an optional assistant prefill to the request without recording a session message', async () => {
+    const adapter = new MockAdapter([textResponse('ok')])
+    const ctx = await harness(adapter)
+    const agent = ctx.agentLoop.create(SessionId('assistant-prefill'), { provider: 'mock', model: 'mock' })
+    ctx.on('agent/pre-step', async (_payload, next) => {
+      const decision = await next()
+      if (decision.kind === 'reject') return decision
+      return {
+        ...decision,
+        assistantPrefill: createAssistantMessage({
+          content: [{ type: 'text', text: 'forced continuation' }],
+          source: { provider: 'mock', model: 'mock' },
+        }),
+      }
+    })
+
+    send(agent, 'hello')
+    await waitForIdle(ctx, agent)
+
+    // Request-only: no assistant/message is appended before the model streams.
+    const assistantMessages = events(agent).filter(event => event.type === 'assistant/message')
+    expect(assistantMessages).toHaveLength(1)
+    const order = events(agent).map(event => event.type)
+    expect(order.indexOf('assistant/message')).toBeGreaterThan(order.indexOf('assistant/chunk'))
+
+    // The prefill rides the request tail and is reconstructable from the header.
+    const requestMessages = adapter.requests[0]!.messages
+    const tail = requestMessages.at(-1)
+    expect(tail?.role).toBe('assistant')
+    expect(tail?.content).toEqual([{ type: 'text', text: 'forced continuation' }])
+    const header = events(agent).find(event => event.type === 'request/header')
+    expect(header?.type === 'request/header' && header.data.header.assistantPrefill?.content)
+      .toEqual([{ type: 'text', text: 'forced continuation' }])
+  })
+
